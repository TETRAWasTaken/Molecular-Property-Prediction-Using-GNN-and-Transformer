    "   \"source\": [\n",
    "    \"#testing the pipeline with sample dataset \\n\",\n",
    "    \"#sample data of 500 molecules\\n\",\n",
    "    \"sample_df = df.sample(n=500, random_state=42).reset_index(drop=True)\\n\",\n",
    "    \"target_cols = ['E1-CC2', 'E2-CC2', 'f1-CC2', 'f2-CC2', 'mu', 'alpha', 'homo', 'lumo', 'gap', 'r2', 'zpve', 'u0']\\n\",\n",
    "    \"\\n\",\n",
    "    \"#Y and Mask arrays for the sample\\n\",\n",
    "    \"sample_Y = sample_df[target_cols].fillna(0).values\\n\",\n",
    "    \"sample_Mask = sample_df[target_cols].notna().astype(int).values\\n\",\n",
    "    \"\\n\",\n",
    "    \"#Convert them to PyTorch Tensors\\n\",\n",
    "    \"y_tensor = torch.tensor(sample_Y, dtype=torch.float32)\\n\",\n",
    "    \"mask_tensor = torch.tensor(sample_Mask, dtype=torch.float32)\\n\",\n",
    "    \"print(sample_df.head())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 32,\n",
    "   \"id\": \"e07fa73f\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def smiles_to_graph_advanced(smiles, y_values, mask_values):\\n\",\n",
    "    \"    # 1. Convert SMILES to RDKit Molecule\\n\",\n",
    "    \"    mol = Chem.MolFromSmiles(smiles)\\n\",\n",
    "    \"    if not mol:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Node Features (The Atoms) ---\\n\",\n",
    "    \"    node_feats = []\\n\",\n",
    "    \"    for atom in mol.GetAtoms():\\n\",\n",
    "    \"        node_feats.append([\\n\",\n",
    "    \"            atom.GetAtomicNum(),         \\n\",\n",
    "    \"            atom.GetDegree(),            \\n\",\n",
    "    \"            atom.GetFormalCharge(),      \\n\",\n",
    "    \"            atom.GetTotalNumHs(),        \\n\",\n",
    "    \"            int(atom.GetIsAromatic()),   \\n\",\n",
    "    \"            int(atom.GetHybridization()) \\n\",\n",
    "    \"        ])\\n\",\n",
    "    \"    x = torch.tensor(node_feats, dtype=torch.float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Edge Logic (The Bonds) ---\\n\",\n",
    "    \"    edge_indices = []\\n\",\n",
    "    \"    edge_attrs = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for bond in mol.GetBonds():\\n\",\n",
    "    \"        i = bond.GetBeginAtomIdx()\\n\",\n",
    "    \"        j = bond.GetEndAtomIdx()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # 1. Get the Features (The \\\"Legend\\\")\\n\",\n",
    "    \"        # We use BondTypeAsDouble (1.0=Single, 2.0=Double, 1.5=Aromatic)\\n\",\n",
    "    \"        bond_feats = [\\n\",\n",
    "    \"            float(bond.GetBondTypeAsDouble()), \\n\",\n",
    "    \"            float(bond.GetIsConjugated()),\\n\",\n",
    "    \"            float(bond.GetIsAromatic())\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # 2. Add Connection i -> j\\n\",\n",
    "    \"        edge_indices.append([i, j])      # The Map\\n\",\n",
    "    \"        edge_attrs.append(bond_feats)    # The Legend\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # 3. Add Connection j -> i (Bi-directional)\\n\",\n",
    "    \"        edge_indices.append([j, i])      # The Map\\n\",\n",
    "    \"        edge_attrs.append(bond_feats)    # The Legend\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert to separate tensors\\n\",\n",
    "    \"    # edge_index shape: [2, TotalBonds]\\n\",\n",
    "    \"    edge_index = torch.tensor(edge_indices, dtype=torch.long).t().contiguous()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # edge_attr shape: [TotalBonds, 3]\\n\",\n",
    "    \"    edge_attr = torch.tensor(edge_attrs, dtype=torch.float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Targets ---\\n\",\n",
    "    \"    y = y_values.clone().detach().view(1, -1)\\n\",\n",
    "    \"    mask = mask_values.clone().detach().view(1, -1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Return the Data object with both tensors separated\\n\",\n",
    "    \"    return Data(x=x, edge_index=edge_index, edge_attr=edge_attr, y=y, mask=mask)\"\n",
    "   ]\n",
    "  },\n",
