    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"\\\"\\\\nTARGET FEATURE DESCRIPTIONS:\\\\n--- QM8 (Electronic Properties / Excited States) ---\\\\nE1-CC2:   First electronic excitation energy (how much energy to move an electron to its first 'jump').\\\\nE2-CC2:   Second electronic excitation energy (energy for the second-level 'jump').\\\\nf1-CC2:   Oscillator strength of the first jump (how likely/bright the transition is).\\\\nf2-CC2:   Oscillator strength of the second jump (intensity of the second transition).\\\\n*Note: 'CC2' refers to the high-level quantum chemistry method used for these calculations.*\\\\n\\\\n--- QM9 (Geometric & Thermodynamic Properties) ---\\\\nA, B, C:  Rotational constants. They define how the molecule's mass is distributed and how it spins.\\\\nmu:       Dipole moment. Measures the 'magnet-like' polarity of the molecule.\\\\nalpha:    Isotropic polarizability. How easily the electron cloud can be 'squished' by an external field.\\\\nhomo:     Highest Occupied Molecular Orbital. The energy of the outermost 'full' electron layer.\\\\nlumo:     Lowest Unoccupied Molecular Orbital. The energy of the first available 'empty' electron layer.\\\\ngap:      The Energy Gap (LUMO minus HOMO). Determines if the molecule is a conductor or insulator.\\\\n\\\"\"\n",
    "      ]\n",
    "     },\n",
    "     \"execution_count\": 23,\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"execute_result\"\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"TARGET FEATURE DESCRIPTIONS:\\n\",\n",
    "    \"--- QM8 (Electronic Properties / Excited States) ---\\n\",\n",
    "    \"E1-CC2:   First electronic excitation energy (how much energy to move an electron to its first 'jump').\\n\",\n",
    "    \"E2-CC2:   Second electronic excitation energy (energy for the second-level 'jump').\\n\",\n",
    "    \"f1-CC2:   Oscillator strength of the first jump (how likely/bright the transition is).\\n\",\n",
    "    \"f2-CC2:   Oscillator strength of the second jump (intensity of the second transition).\\n\",\n",
    "    \"*Note: 'CC2' refers to the high-level quantum chemistry method used for these calculations.*\\n\",\n",
    "    \"\\n\",\n",
    "    \"--- QM9 (Geometric & Thermodynamic Properties) ---\\n\",\n",
    "    \"A, B, C:  Rotational constants. They define how the molecule's mass is distributed and how it spins.\\n\",\n",
    "    \"mu:       Dipole moment. Measures the 'magnet-like' polarity of the molecule.\\n\",\n",
    "    \"alpha:    Isotropic polarizability. How easily the electron cloud can be 'squished' by an external field.\\n\",\n",
    "    \"homo:     Highest Occupied Molecular Orbital. The energy of the outermost 'full' electron layer.\\n\",\n",
    "    \"lumo:     Lowest Unoccupied Molecular Orbital. The energy of the first available 'empty' electron layer.\\n\",\n",
    "    \"gap:      The Energy Gap (LUMO minus HOMO). Determines if the molecule is a conductor or insulator.\\n\",\n",
    "    \"\\\"\\\"\\\"\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 25,\n",
    "   \"id\": \"3fffbb71\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"#class and object form of the same code (still working on it)\\n\",\n",
    "    \"class MoleculeDataPipeline:\\n\",\n",
    "    \"    def __init__(self, qm8_path, qm9_path):\\n\",\n",
    "    \"        self.qm8_path = \\\"C:\\\\\\\\Users\\\\\\\\kolhe\\\\\\\\gnn\\\\\\\\Molecular-Property-Prediction-Using-GNN-and-Transformer\\\\\\\\Dataset\\\\\\\\qm8.csv\\\"\\n\",\n",
    "    \"        self.qm9_path = \\\"C:\\\\\\\\Users\\\\\\\\kolhe\\\\\\\\gnn\\\\\\\\Molecular-Property-Prediction-Using-GNN-and-Transformer\\\\\\\\Dataset\\\\\\\\qm9.csv\\\"\\n\",\n",
    "    \"        self.df = None\\n\",\n",
    "    \"        self.Y = None\\n\",\n",
    "    \"        self.mask = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def _canonicalize(self, smiles):\\n\",\n",
    "    \"        #standardizes SMILES strings \\n\",\n",
    "    \"        mol = Chem.MolFromSmiles(smiles)\\n\",\n",
    "    \"        return Chem.MolToSmiles(mol) if mol else None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def process_and_merge(self):\\n\",\n",
    "    \"        #load data\\n\",\n",
    "    \"        df8 = pd.read_csv(self.qm8_path)\\n\",\n",
    "    \"        df9 = pd.read_csv(self.qm9_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        #Canonicalize SMILES for both\\n\",\n",
    "    \"        df8['smiles_new'] = df8['smiles'].apply(self._canonicalize)\\n\",\n",
    "    \"        df9['smiles_new'] = df9['smiles'].apply(self._canonicalize)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Outer Join (merge)\\n\",\n",
    "    \"        self.master_df = pd.merge(df8, df9, on='smiles_new', how='outer')\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # 12 Property Columns\\n\",\n",
    "    \"        target_cols = ['E1-CC2', 'E2-CC2', 'f1-CC2', 'f2-CC2', # qm8\\n\",\n",
    "    \"                       'mu', 'alpha', 'homo', 'lumo', 'gap', 'r2', 'zpve', 'u0'] #qm9\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        #Create mask and Y\\n\",\n",
    "    \"        data_subset = self.master_df[target_cols]\\n\",\n",
    "    \"        self.mask = data_subset.notna().astype(int).values\\n\",\n",
    "    \"        self.Y = data_subset.fillna(0).values\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(f\\\"Pipeline Complete: {len(self.master_df)} total molecules processed.\\\")\\n\",\n",
    "    \"        return self.master_df, self.Y, self.mask\"\n",
    "   ]\n",
    "  },\n",
