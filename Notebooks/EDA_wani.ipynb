    "    \"# but the MASK will tell the model to ignore these 0 since we are filling 1 at places where data exists.\\n\",\n",
    "    \"Mask = df[target_columns].notna().astype(int).values\\n\",\n",
    "    \"print(f\\\"Target Shape: {Y.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Mask Shape: {Mask.shape}\\\")\"\n",
    "   ]\n",
