    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 33,\n",
    "   \"id\": \"b6d89079\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class MolecularPropertyPipeline:\\n\",\n",
    "    \"    '''\\n\",\n",
    "    \"    Comprehensive class for the entire molecular property prediction pipeline.\\n\",\n",
    "    \"    Handles data loading, preprocessing, canonicalization, merging, and graph generation.\\n\",\n",
    "    \"    Operates on the full dataset.\\n\",\n",
    "    \"    '''\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, qm8_path: str, qm9_path: str):\\n\",\n",
    "    \"        \\\"\\\"\\\"Initialize the pipeline with paths to QM8 and QM9 datasets.\\\"\\\"\\\"\\n\",\n",
    "    \"        self.qm8_path = qm8_path\\n\",\n",
    "    \"        self.qm9_path = qm9_path\\n\",\n",
    "    \"        self.df8 = None\\n\",\n",
    "    \"        self.df9 = None\\n\",\n",
    "    \"        self.df_merged = None\\n\",\n",
    "    \"        self.Y = None\\n\",\n",
    "    \"        self.Y_tensor = None\\n\",\n",
    "    \"        self.mask = None\\n\",\n",
    "    \"        self.mask_tensor = None\\n\",\n",
    "    \"        self.graphs = None\\n\",\n",
    "    \"        self.data_loader = None\\n\",\n",
    "    \"        self.target_cols = ['E1-CC2', 'E2-CC2', 'f1-CC2', 'f2-CC2',  # QM8\\n\",\n",
    "    \"                           'mu', 'alpha', 'homo', 'lumo', 'gap', 'r2', 'zpve', 'u0']  # QM9\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Data Loading ====================\\n\",\n",
    "    \"    def load_data(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Load QM8 and QM9 CSV files.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"Loading QM8 and QM9 datasets...\\\")\\n\",\n",
    "    \"        self.df8 = pd.read_csv(self.qm8_path)\\n\",\n",
    "    \"        self.df9 = pd.read_csv(self.qm9_path)\\n\",\n",
    "    \"        print(f\\\"QM8 shape: {self.df8.shape}\\\")\\n\",\n",
    "    \"        print(f\\\"QM9 shape: {self.df9.shape}\\\")\\n\",\n",
    "    \"        return self.df8, self.df9\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def validate_data(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Check for missing values and data quality issues.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\n--- QM8 Data Quality ---\\\")\\n\",\n",
    "    \"        print(f\\\"Null values:\\\\n{self.df8.isnull().sum()}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(\\\"\\\\n--- QM9 Data Quality ---\\\")\\n\",\n",
    "    \"        print(f\\\"Null values:\\\\n{self.df9.isnull().sum()}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Check for empty SMILES\\n\",\n",
    "    \"        empty_smiles_qm8 = (self.df8['smiles'].str.strip() == \\\"\\\").sum()\\n\",\n",
    "    \"        empty_smiles_qm9 = (self.df9['smiles'].str.strip() == \\\"\\\").sum()\\n\",\n",
    "    \"        print(f\\\"\\\\nEmpty SMILES in QM8: {empty_smiles_qm8}\\\")\\n\",\n",
    "    \"        print(f\\\"Empty SMILES in QM9: {empty_smiles_qm9}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== SMILES Canonicalization ====================\\n\",\n",
    "    \"    def _canonicalize(self, smiles):\\n\",\n",
    "    \"        \\\"\\\"\\\"Convert a SMILES string to its canonical form.\\\"\\\"\\\"\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            mol = Chem.MolFromSmiles(smiles)\\n\",\n",
    "    \"            return Chem.MolToSmiles(mol) if mol else None\\n\",\n",
    "    \"        except:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def canonicalize_smiles(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Canonicalize SMILES in both datasets.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\nCanonicalizing SMILES strings...\\\")\\n\",\n",
    "    \"        self.df8['smiles_new'] = self.df8['smiles'].apply(self._canonicalize)\\n\",\n",
    "    \"        self.df9['smiles_new'] = self.df9['smiles'].apply(self._canonicalize)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Remove rows with invalid SMILES\\n\",\n",
    "    \"        self.df8 = self.df8[self.df8['smiles_new'].notna()]\\n\",\n",
    "    \"        self.df9 = self.df9[self.df9['smiles_new'].notna()]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(f\\\"QM8 after canonicalization: {self.df8.shape}\\\")\\n\",\n",
    "    \"        print(f\\\"QM9 after canonicalization: {self.df9.shape}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Data Merging ====================\\n\",\n",
    "    \"    def merge_datasets(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Merge QM8 and QM9 datasets using outer join on canonicalized SMILES.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\nMerging QM8 and QM9 datasets...\\\")\\n\",\n",
    "    \"        self.df_merged = pd.merge(self.df8, self.df9, on='smiles_new', how='outer')\\n\",\n",
    "    \"        print(f\\\"Merged dataset shape: {self.df_merged.shape}\\\")\\n\",\n",
    "    \"        return self.df_merged\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Targets and Masks ====================\\n\",\n",
    "    \"    def create_targets_and_masks(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Create target matrices (Y) and masks.\\n\",\n",
    "    \"        - Y: Contains property values (NaN replaced with 0)\\n\",\n",
    "    \"        - mask: Indicates which values are real (1) vs. NaN replacements (0)\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\nCreating target matrices and masks...\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Fill NaNs with 0 (for numerical stability)\\n\",\n",
    "    \"        self.Y = self.df_merged[self.target_cols].fillna(0).values\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Create mask: 1 where data exists, 0 where it was NaN\\n\",\n",
    "    \"        self.mask = self.df_merged[self.target_cols].notna().astype(int).values\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(f\\\"Target (Y) shape: {self.Y.shape}\\\")\\n\",\n",
    "    \"        print(f\\\"Mask shape: {self.mask.shape}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Print sparsity information\\n\",\n",
    "    \"        total_values = self.Y.size\\n\",\n",
    "    \"        missing_values = (self.mask == 0).sum()\\n\",\n",
    "    \"        sparsity = (missing_values / total_values) * 100\\n\",\n",
    "    \"        print(f\\\"Data sparsity: {sparsity:.2f}%\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return self.Y, self.mask\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def get_tensors(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Convert Y and mask to PyTorch tensors.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\nConverting to PyTorch tensors...\\\")\\n\",\n",
    "    \"        self.Y_tensor = torch.tensor(self.Y, dtype=torch.float32)\\n\",\n",
    "    \"        self.mask_tensor = torch.tensor(self.mask, dtype=torch.float32)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(f\\\"Y tensor shape: {self.Y_tensor.shape}\\\")\\n\",\n",
    "    \"        print(f\\\"Mask tensor shape: {self.mask_tensor.shape}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return self.Y_tensor, self.mask_tensor\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Graph Generation ====================\\n\",\n",
    "    \"    def _smiles_to_graph(self, smiles: str, y_values, mask_values):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Convert a SMILES string to a PyTorch Geometric Data object (graph).\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            smiles: Canonical SMILES string\\n\",\n",
    "    \"            y_values: Target property values for this molecule\\n\",\n",
    "    \"            mask_values: Mask values for this molecule\\n\",\n",
    "    \"            \\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Data object with node features, edge indices/attributes, targets, and masks\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        mol = Chem.MolFromSmiles(smiles)\\n\",\n",
    "    \"        if not mol:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # --- Node Features (Atoms) ---\\n\",\n",
    "    \"        node_feats = []\\n\",\n",
    "    \"        for atom in mol.GetAtoms():\\n\",\n",
    "    \"            node_feats.append([\\n\",\n",
    "    \"                atom.GetAtomicNum(),           # Atomic number\\n\",\n",
    "    \"                atom.GetDegree(),              # Number of bonds\\n\",\n",
    "    \"                atom.GetFormalCharge(),        # Charge\\n\",\n",
    "    \"                atom.GetTotalNumHs(),          # Number of hydrogens\\n\",\n",
    "    \"                int(atom.GetIsAromatic()),     # Is aromatic?\\n\",\n",
    "    \"                int(atom.GetHybridization())   # Hybridization type\\n\",\n",
    "    \"            ])\\n\",\n",
    "    \"        x = torch.tensor(node_feats, dtype=torch.float)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # --- Edge Features (Bonds) ---\\n\",\n",
    "    \"        edge_indices = []\\n\",\n",
    "    \"        edge_attrs = []\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for bond in mol.GetBonds():\\n\",\n",
    "    \"            i = bond.GetBeginAtomIdx()\\n\",\n",
    "    \"            j = bond.GetEndAtomIdx()\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            bond_feats = [\\n\",\n",
    "    \"                float(bond.GetBondTypeAsDouble()),  # Bond type (1.0=single, 2.0=double, 1.5=aromatic)\\n\",\n",
    "    \"                float(bond.GetIsConjugated()),      # Is conjugated?\\n\",\n",
    "    \"                float(bond.GetIsAromatic())         # Is aromatic?\\n\",\n",
    "    \"            ]\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Add bidirectional edges\\n\",\n",
    "    \"            edge_indices.append([i, j])\\n\",\n",
    "    \"            edge_attrs.append(bond_feats)\\n\",\n",
    "    \"            edge_indices.append([j, i])\\n\",\n",
    "    \"            edge_attrs.append(bond_feats)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        edge_index = torch.tensor(edge_indices, dtype=torch.long).t().contiguous()\\n\",\n",
    "    \"        edge_attr = torch.tensor(edge_attrs, dtype=torch.float)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # --- Targets and Masks ---\\n\",\n",
    "    \"        y = y_values.clone().detach().view(1, -1)\\n\",\n",
    "    \"        mask = mask_values.clone().detach().view(1, -1)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return Data(x=x, edge_index=edge_index, edge_attr=edge_attr, y=y, mask=mask)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def generate_graphs(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Generate graph representations for all molecules.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\nGenerating molecular graphs...\\\")\\n\",\n",
    "    \"        self.graphs = []\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        num_molecules = len(self.df_merged)\\n\",\n",
    "    \"        failed_count = 0\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for i in range(num_molecules):\\n\",\n",
    "    \"            if (i + 1) % 1000 == 0:\\n\",\n",
    "    \"                print(f\\\"Processed {i + 1}/{num_molecules} molecules ({100*(i+1)/num_molecules:.1f}%)\\\")\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            smiles = self.df_merged['smiles_new'].iloc[i]\\n\",\n",
    "    \"            y_val = self.Y_tensor[i]\\n\",\n",
    "    \"            mask_val = self.mask_tensor[i]\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            graph = self._smiles_to_graph(smiles, y_val, mask_val)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            if graph:\\n\",\n",
    "    \"                self.graphs.append(graph)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                failed_count += 1\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(f\\\"\\\\nGraph generation complete!\\\")\\n\",\n",
    "    \"        print(f\\\"Successfully generated {len(self.graphs)} graphs\\\")\\n\",\n",
    "    \"        print(f\\\"Failed to convert: {failed_count} molecules\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return self.graphs\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== DataLoader ====================\\n\",\n",
    "    \"    def create_dataloader(self, batch_size: int = 32, shuffle: bool = True):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Create a PyTorch Geometric DataLoader for batch processing.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            batch_size: Number of graphs per batch\\n\",\n",
    "    \"            shuffle: Whether to shuffle the data\\n\",\n",
    "    \"            \\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            DataLoader object\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        print(f\\\"\\\\nCreating DataLoader (batch_size={batch_size})...\\\")\\n\",\n",
    "    \"        self.data_loader = DataLoader(self.graphs, batch_size=batch_size, shuffle=shuffle)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Get info from first batch\\n\",\n",
    "    \"        first_batch = next(iter(self.data_loader))\\n\",\n",
    "    \"        print(f\\\"Number of batches: {len(self.data_loader)}\\\")\\n\",\n",
    "    \"        print(f\\\"Molecules per batch: {first_batch.num_graphs}\\\")\\n\",\n",
    "    \"        print(f\\\"Atoms per batch: {first_batch.x.shape[0]}\\\")\\n\",\n",
    "    \"        print(f\\\"Node features: {first_batch.num_node_features}\\\")\\n\",\n",
    "    \"        print(f\\\"Edge features: {first_batch.edge_attr.shape[1]}\\\")\\n\",\n",
    "    \"        print(f\\\"Target shape per batch: {first_batch.y.shape}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return self.data_loader\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Full Pipeline ====================\\n\",\n",
    "    \"    def run_full_pipeline(self, batch_size: int = 32):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Execute the complete pipeline from raw data to DataLoader.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            batch_size: Batch size for the DataLoader\\n\",\n",
    "    \"            \\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            DataLoader object for model training\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"=\\\" * 60)\\n\",\n",
    "    \"        print(\\\"Starting Full Molecular Property Prediction Pipeline\\\")\\n\",\n",
    "    \"        print(\\\"=\\\" * 60)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 1: Load data\\n\",\n",
    "    \"        self.load_data()\\n\",\n",
    "    \"        self.validate_data()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 2: Canonicalize SMILES\\n\",\n",
    "    \"        self.canonicalize_smiles()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 3: Merge datasets\\n\",\n",
    "    \"        self.merge_datasets()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 4: Create targets and masks\\n\",\n",
    "    \"        self.create_targets_and_masks()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 5: Convert to tensors\\n\",\n",
    "    \"        self.get_tensors()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 6: Generate graphs\\n\",\n",
    "    \"        self.generate_graphs()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Step 7: Create DataLoader\\n\",\n",
    "    \"        self.create_dataloader(batch_size=batch_size)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"        print(\\\"Pipeline Complete!\\\")\\n\",\n",
    "    \"        print(\\\"=\\\" * 60)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return self.data_loader\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # ==================== Utility Methods ====================\\n\",\n",
    "    \"    def get_summary(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Print summary statistics of the pipeline.\\\"\\\"\\\"\\n\",\n",
    "    \"        print(\\\"\\\\n--- Pipeline Summary ---\\\")\\n\",\n",
    "    \"        print(f\\\"Total molecules: {len(self.df_merged)}\\\")\\n\",\n",
    "    \"        print(f\\\"Valid graphs created: {len(self.graphs)}\\\")\\n\",\n",
    "    \"        print(f\\\"Target features: {len(self.target_cols)}\\\")\\n\",\n",
    "    \"        print(f\\\"Data sparsity: {((self.mask == 0).sum() / self.mask.size) * 100:.2f}%\\\")\\n\",\n",
    "    \"        print(f\\\"DataLoader batches: {len(self.data_loader) if self.data_loader else 'Not created'}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def visualize_molecule(self, index: int):\\n\",\n",
