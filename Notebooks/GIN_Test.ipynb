    "    \"\\n\",\n",
    "    \"fig = plt.figure()\\n\",\n",
    "    \"ax = fig.add_subplot(111, projection='3d')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for dim in (ax.xaxis, ax.yaxis, ax.zaxis):\\n\",\n",
    "    \"    dim.set_ticks([])\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.scatter(*node_xyz.T, s=500, c='#0A047A')\\n\",\n",
    "    \"\\n\",\n",
