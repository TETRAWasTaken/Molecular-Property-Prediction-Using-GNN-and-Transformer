    "   \"source\": [\n",
    "    \"G = to_networkx(data['graph'][0], to_undirected=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"pos = nx.spring_layout(G, dim=3, seed=0)\\n\",\n",
