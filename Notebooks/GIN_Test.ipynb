    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def smiles_to_graph(smiles):\\n\",\n",
    "    \"    mol = Chem.MolFromSmiles(smiles)\\n\",\n",
    "    \"    if mol is None:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Add hydrogens explicitly as they are often important in QM datasets\\n\",\n",
    "    \"    mol = Chem.AddHs(mol)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Atom features: Atomic number\\n\",\n",
    "    \"    atom_features = []\\n\",\n",
    "    \"    for atom in mol.GetAtoms():\\n\",\n",
    "    \"        atom_features.append([atom.GetAtomicNum()])\\n\",\n",
    "    \"    x = torch.tensor(atom_features, dtype=torch.float)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Edge index: Bonds\\n\",\n",
    "    \"    edge_index = []\\n\",\n",
    "    \"    for bond in mol.GetBonds():\\n\",\n",
    "    \"        i = bond.GetBeginAtomIdx()\\n\",\n",
    "    \"        j = bond.GetEndAtomIdx()\\n\",\n",
    "    \"        edge_index.append([i, j])\\n\",\n",
    "    \"        edge_index.append([j, i])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if not edge_index:\\n\",\n",
    "    \"        edge_index = torch.empty((2, 0), dtype=torch.long)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        edge_index = torch.tensor(edge_index, dtype=torch.long).t().contiguous()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return Data(x=x, edge_index=edge_index)\\n\",\n",
    "    \"\\n\",\n",
    "    \"data['graph'] = data['smiles'].apply(smiles_to_graph)\"\n",
    "   ],\n",
    "   \"id\": \"d661bf3c41bbac5e\",\n",
